{
  "manifest_version": 3,
  "name": "AutoResume - Browser MCP Automation",
  "version": "1.0.0",
  "description": "Autonomous browser agent for job applications with Model Context Protocol (MCP) bridge, live execution feed, and sidepanel wrapper.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AutoResume AI Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "tabGroups",
    "tabs",
    "unlimitedStorage",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Toggle AutoResume sidepanel"
    }
  }
}
